# EduCore — Supabase Environment Configuration (Sprint 14 Walking Skeleton)
# Copy this file to .env.local and replace with your project's Supabase credentials.
# Do NOT commit .env.local or real secrets to version control.

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
